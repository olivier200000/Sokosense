# ============================================================
# SokoSense website settings
# 1. Make a copy of this file named  .env  (in the same folder)
# 2. Fill in your real values in .env
# 3. Never share .env or upload it to GitHub - it holds passwords
# ============================================================

# ---------- Email: where contact messages are sent ----------
# Gmail:   MAIL_SERVER=smtp.gmail.com       MAIL_PORT=465
# Outlook: MAIL_SERVER=smtp.office365.com   MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465

# The email account that SENDS the notifications
MAIL_USERNAME=your-company-email@gmail.com

# For Gmail, this must be an "App password" (16 letters), NOT your normal password.
# Google Account > Security > 2-Step Verification (turn on) > App passwords
MAIL_PASSWORD=your-app-password-here

# Who RECEIVES the messages. Several addresses: separate with commas.
MAIL_TO=your-company-email@gmail.com

# Name shown as the sender in your inbox
MAIL_SENDER_NAME=SokoSense Website

# ---- Only if Gmail is blocked on GoDaddy hosting ----
# GoDaddy's own mail relay needs no password. Use these instead of the Gmail lines:
#   MAIL_SERVER=relay-hosting.secureserver.net
#   MAIL_PORT=25
#   MAIL_USE_SSL=false
#   MAIL_USE_TLS=false
#   MAIL_USE_AUTH=false
#   MAIL_USERNAME=an-address@your-domain.com   (the "From" address)
#   MAIL_TO=olijoos2003@gmail.com

# ---------- Admin area: /admin ----------
# Used to log in and manage news, yearly reports and contact messages.
# Leave any of these three empty to switch the admin area off completely.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# A long random secret that keeps admin logins safe. Create one in Terminal with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------- Other settings ----------
# Keep false on the live website. Use true only while testing on your computer.
FLASK_DEBUG=false

# Set to true ONLY on the live https website (keeps admin logins safe).
# Keep false on your Mac, otherwise you cannot log in to /admin locally.
SECURE_COOKIES=false

# Where the database file is stored (optional).
# DATABASE_PATH=data/messages.db

# Where uploaded reports and news photos are stored (optional).
# UPLOAD_PATH=data/uploads
# Largest file an admin can upload, in MB (optional).
# MAX_UPLOAD_MB=20
